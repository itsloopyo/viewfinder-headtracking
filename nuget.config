<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Clear first so the restore graph is exactly these two feeds. Without it,
         machine- and user-level NuGet.Config sources are merged in, and any of
         them can serve a package that matches one of ours and win the restore.
         A developer's private feed and a CI runner's defaults then also resolve
         different binaries from the same checkout. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <!-- Clearing alone still leaves two feeds, and NuGet takes a package from
       whichever answers first. The BepInEx packages this build uses are
       unclaimed on nuget.org, and UnityEngine.Modules is held there by a
       different, unverified owner, so a matching version published there could be
       restored in place of the BepInEx feed's. Each ID is pinned to the one feed
       that serves the version this build uses; the more specific pattern wins
       over "*". -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
      <package pattern="Il2CppInterop.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
  </packageSourceMapping>
</configuration>
